.account-page { max-width: 860rpx; margin: auto; padding: 34rpx 36rpx calc(40rpx + env(safe-area-inset-bottom)); }
.account-eyebrow { color: #87917d; letter-spacing: 3rpx; font-size: 22rpx; }
.account-title { font-size: 38rpx; line-height: 1.5; font-weight: 600; margin: 14rpx 0 30rpx; }
.account-card { background: #f0eddf; border-radius: 30rpx; padding: 34rpx; text-align: center; }
.account-avatar { width: 100rpx; height: 100rpx; margin: 0 auto 20rpx; background: #e1e8d5; color: #426751; border-radius: 50%; font-size: 48rpx; line-height: 100rpx; }
.account-name { font-size: 34rpx; font-weight: 600; }
.account-description { font-size: 23rpx; line-height: 1.8; color: #7b8573; margin: 12rpx 0 24rpx; }
.signed-in { color: #426751; font-size: 24rpx; }
.section-label { font-size: 23rpx; color: #8a927e; margin: 38rpx 0 14rpx; }
.account-row { margin: 0; padding: 24rpx 0; width: 100%; background: transparent; border-bottom: 1rpx solid #e9e8dc; display: flex; align-items: center; justify-content: space-between; text-align: left; line-height: 1.6; font-size: 28rpx; }
.account-row view > text { display: block; font-size: 22rpx; color: #8b937f; margin-top: 6rpx; }
.account-row > text { color: #8b937f; font-size: 36rpx; padding-left: 18rpx; }
.local-note { font-size: 23rpx; line-height: 1.8; color: #8a927e; margin-top: 24rpx; }
.error { font-size: 24rpx; color: #a24b39; line-height: 1.8; margin-top: 16rpx; }
.text-button { font-size: 24rpx; color: #426751; background: transparent; }
.logout-button { margin-top: 40rpx; }
.guide-card, .edit-card, .danger-card { margin-top: 28rpx; padding: 28rpx; border-radius: 24rpx; background: #edf0e5; }
.guide-title { font-size: 30rpx; line-height: 1.6; font-weight: 600; }
.guide-card .primary-button { margin-top: 24rpx; }
.edit-card label, .danger-card label { display: block; font-size: 25rpx; margin: 25rpx 0 14rpx; }
.edit-card input, .danger-card input { background: #fffdf7; border: 1rpx solid #d9ddce; padding: 22rpx; height: 92rpx; font-size: 28rpx; border-radius: 15rpx; margin-bottom: 22rpx; }
.danger-card { background: #f5e9df; }
.danger-button { background: #9c4b3b; color: #fffdf7; border-radius: 22rpx; padding: 20rpx; font-size: 28rpx; line-height: 1.5; }
.reading-stats { color: #426751; font-size: 26rpx; margin-top: 12rpx; }
.child-details { display: flex; gap: 24rpx; align-items: center; margin-top: 22rpx; }
.child-photo, .child-placeholder { width: 110rpx; height: 130rpx; flex-shrink: 0; border-radius: 18rpx; background: #fffdf7; }
.child-placeholder { color: #426751; text-align: center; font-size: 44rpx; line-height: 130rpx; }
.child-copy { min-width: 0; font-size: 23rpx; line-height: 1.8; color: #7b8573; overflow-wrap: anywhere; }
.child-name { color: #354a3a; font-size: 30rpx; font-weight: 600; }
.backup-card label { display: block; font-size: 25rpx; margin: 24rpx 0 14rpx; }
.backup-card input { background: #fffdf7; border: 1rpx solid #d9ddce; padding: 22rpx; height: 92rpx; font-size: 28rpx; border-radius: 15rpx; margin-bottom: 22rpx; }
.backup-card .primary-button { margin-top: 22rpx; }
