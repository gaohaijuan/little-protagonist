.profile-page{padding:32rpx 40rpx 60rpx;padding-bottom:calc(60rpx + env(safe-area-inset-bottom))}.page-title{font-size:44rpx;font-weight:600;display:block;color:#2f4035}.subtitle{display:block;font-size:26rpx;color:#697267;margin-top:12rpx}.hero-preview{height:380rpx;margin:28rpx 0 22rpx;border-radius:32rpx;overflow:hidden;background:#fbf6e9}.photo-actions,.editor-actions{display:flex;align-items:center;justify-content:center;gap:20rpx}.photo-actions button{margin:0}.primary,.secondary{font-size:30rpx;min-height:92rpx;border-radius:22rpx;display:flex;justify-content:center;align-items:center;padding:16rpx 26rpx;line-height:1.4}.primary{background:#426950;color:#fff}.secondary{background:#fffdf7;color:#426950;border:1rpx solid #dce2d3}button::after{border:0}.text-button{font-size:24rpx;padding:12rpx;color:#697267;background:transparent;line-height:1.5}.hint{display:block;color:#697267;font-size:24rpx;line-height:1.7;margin-top:16rpx}.field{margin-top:32rpx;font-size:27rpx;color:#52604f}.field label{display:block}.field input,.picker-value{margin-top:14rpx;padding:24rpx;border:1rpx solid #dce2d3;border-radius:20rpx;background:#fffdf7;color:#2f4035;font-size:32rpx}.field input{height:46rpx}.field-row{display:flex;gap:24rpx}.field-row .field{flex:1;min-width:0}.picker-value{display:flex;justify-content:space-between}.error{display:block;color:#a84231;line-height:1.6;font-size:27rpx;margin-top:24rpx}.save-button{margin-top:34rpx}.privacy-note{display:block;text-align:center;color:#697267;font-size:23rpx;margin-top:24rpx}.crop-wrap{width:480rpx;height:506.6667rpx;box-sizing:content-box;margin:32rpx auto;overflow:hidden;border-radius:50%;background:#e8eddf;border:6rpx solid #fffdf7}.crop-canvas{width:100%;height:100%}.crop-control{font-size:27rpx;color:#52604f;margin-top:16rpx}.crop-control slider{margin:16rpx 0 26rpx}.editor-actions{margin-top:36rpx}.editor-actions button{flex:1;margin:0}.export-canvas{position:absolute;left:-10000px;top:0;width:1px;height:1px;pointer-eve