.bookshelf { padding: 38rpx 36rpx calc(36rpx + env(safe-area-inset-bottom)); max-width: 920rpx; margin: 0 auto; }
.greeting-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 34rpx; }
.greeting-text { min-width: 0; padding-right: 20rpx; }
.eyebrow { font-size: 23rpx; color: #869080; }
.greeting { margin-top: 10rpx; font-size: 39rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.avatar-button { margin: 0; padding: 0; width: 100rpx; height: 100rpx; flex-shrink: 0; border-radius: 50%; overflow: hidden; background: #f0e7d6; }
.hero { height: 332rpx; position: relative; overflow: hidden; border-radius: 34rpx; background: #f0ecdf; }
.hero-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-copy { position: relative; z-index: 1; padding: 36rpx 30rpx; pointer-events: none; }
.hero-label { font-size: 21rpx; color: #7d8775; }
.hero-title { margin-top: 17rpx; font-size: 43rpx; font-weight: 600; line-height: 1.5; }
.hero-note { display: block; margin-top: 15rpx; font-size: 21rpx; color: #7d8775; }
.start-button { width: 100%; margin: 24rpx 0 44rpx; }
.button-arrow { margin-left: 20rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.section-title { font-size: 30rpx; font-weight: 600; }
.level-badge { font-size: 20rpx; color: #77826f; }
.book-list { display: flex; align-items: stretch; margin: 0 -8rpx; }
.book-card { flex: 1; width: 0; padding: 0 8rpx; margin: 0; background: transparent; text-align: left; line-height: 1.5; }
.book-cover { position: relative; height: 240rpx; width: 100%; border-radius: 17rpx 24rpx 24rpx 17rpx; overflow: hidden; background: #ede8d8; border-left: 7rpx solid rgba(112, 127, 82, .13); }
.book-cover.peach { background: #f0e4d5; }.book-cover.green { background: #e9efdf; }.book-cover.yellow { background: #f4ecd4; }
.cover-number { position: absolute; left: 12rpx; top: 9rpx; font-size: 20rpx; color: #7b876c; }
.book-title { margin-top: 17rpx; font-size: 24rpx; font-weight: 600; min-height: 72rpx; overflow-wrap: anywhere; }
.book-tag { font-size: 19rpx; color: #929986; margin-top: 6rpx; }
.shelf-note { text-align: center; color: #99a08d; font-size: 22rpx; margin: 38rpx 0; }
.bottom-bar { border-top: 1rpx solid #e7e8da; display: flex; padding-top: 20rpx; align-items: center; }
.current-tab, .profile-tab { width: 50%; display: flex; flex-direction: column; align-items: center; font-size: 22rpx; line-height: 1.5; }
.current-tab { color: #426751; font-weight: 600; }.profile-tab { margin: 0; padding: 0; background: transparent; color: #929986; }
.tab-mark { font-size: 35rpx; height: 44rpx; }
.bottom-bar > view, .bottom-bar > button { width: 33.333%; }
