# Copy to .env only on the destination; never commit real secrets.
# Node does not auto-load .env for npm scripts. See migration/STARTUP.md.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4180
# Local-only app default password is documented in server/README.md.
# ADMIN_PASSWORD=REPLACE_WITH_A_NEW_LOCAL_PASSWORD
# PUBLIC_ORIGIN=https://YOUR_AUTHORIZED_HOST
# ADMIN_DATA_DIR=C:/YOUR_PRIVATE_DATA_DIRECTORY
# PRINT_RETENTION_DAYS=YOUR_POLICY_DAYS
# ORDER_CONTACT_RETENTION_DAYS=YOUR_POLICY_DAYS
# WX_APP_ID=YOUR_APP_ID
# WX_APP_SECRET=SET_PRIVATELY
# DOUYIN_APP_ID=YOUR_APP_ID
# DOUYIN_APP_SECRET=SET_PRIVATELY
# ACCOUNT_BRIDGE_SECRET=SET_PRIVATELY
# PAYMENT_EVENT_SECRET=SET_PRIVATELY
# MOBILE_TEST_IP=YOUR_PRIVATE_LAN_IP
# MOBILE_TEST_PORT=4181
