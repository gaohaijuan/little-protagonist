{
  "name": "little-story-reader",
  "version": "0.1.0",
  "private": true,
  "description": "小小主角：本地保存头像和名字的中文分级阅读小程序",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check-project.cjs",
    "build:preview": "node scripts/build-preview.cjs",
    "build:drafts": "node scripts/build-story-drafts.cjs",
    "build:site": "node scripts/build-mobile-site.cjs",
    "preview": "node scripts/build-preview.cjs && node scripts/serve-preview.cjs",
    "admin": "node scripts/build-preview.cjs && node server/start.cjs",
    "test:admin": "node --test tests/admin.test.cjs",
    "test:admin-browser": "node tests/admin.browser.cjs",
    "test:browser": "node tests/preview.browser.cjs",
    "test:auth": "node --test tests/auth.test.cjs tests/account-page.test.cjs",
    "test:auth-browser": "node tests/auth.browser.cjs",
    "test:covers": "node tests/covers.browser.cjs",
    "test:art-transition": "node tests/art-transition.browser.cjs",
    "test:sequence-art": "node tests/sequence-art.browser.cjs",
    "test:six-books": "node tests/six-books.browser.cjs",
    "test:print-book": "node tests/print-book.browser.cjs",
    "test:download-print": "node tests/download-print.browser.cjs",
    "test:print-service-browser": "node tests/print-service.browser.cjs",
    "test:print-service-orders": "node tests/print-service-orders.browser.cjs",
    "benchmark:composition": "node scripts/benchmark-composition.cjs",
    "test:face": "node tests/face.browser.cjs",
    "test:flower": "node tests/flower.browser.cjs",
    "test:intro": "node tests/intro-ui.browser.cjs",
    "test:intro-art": "node tests/intro-art.browser.cjs",
    "test:family": "node tests/family.browser.cjs",
    "test:family-art": "node tests/family-art.browser.cjs",
    "test:long-hair": "node tests/long-hair.browser.cjs"
  },
  "engines": { "node": ">=18" }
}
